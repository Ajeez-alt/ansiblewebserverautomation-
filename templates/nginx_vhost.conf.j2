# ==============================================================================
# Nginx Virtual Host Configuration Template
# Managed by Ansible - DO NOT EDIT DIRECTLY ON MANAGED NODE
# Host: {{ inventory_hostname }}
# ==============================================================================

server {
    listen {{ http_port | default(80) }} default_server;
    listen [::]:{{ http_port | default(80) }} default_server;

    server_name {{ site_domain | default('_') }};

    root {{ doc_root | default('/var/www/html') }};
    index index.html index.htm;

    # Custom security & identification headers
    add_header X-Managed-By "Ansible-Automation";
    add_header X-Server-Node "{{ inventory_hostname }}";
    add_header X-Node-Tag "{{ custom_header_tag | default('DEFAULT-NODE') }}";

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint for automated verification
    location /health {
        access_log off;
        return 200 "OK - Node {{ inventory_hostname }} is healthy\n";
        add_header Content-Type text/plain;
    }

    # Custom error pages
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
